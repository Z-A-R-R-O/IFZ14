# IFZ14 frontend/API configuration — local development only.
# Copy to .env and replace placeholders. Never commit real credentials.

# Frontend Vite variables
VITE_API_BASE_URL=http://localhost:4000
VITE_API_ACCESS_KEY=

# Express API
API_PORT=4000
API_CORS_ORIGIN=http://localhost:5173

# Development/demo gate only. VITE_API_ACCESS_KEY is bundled into browser code and is NOT a secret.
API_ACCESS_KEY=

# Database connection (local MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ifz14
DB_PASSWORD=change-me
DB_NAME=ifz14
DB_CONNECTION_LIMIT=10

# Optional session auth. Generate a long, random secret for local testing.
# Without this value, the API falls back to a development-only userId mode.
API_SESSION_SECRET=
